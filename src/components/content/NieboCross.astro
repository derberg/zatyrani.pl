---
interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

const registrationUrl = "https://www.leszy.run/events/niebocross-2027";
const memorialPhoto = "https://lh3.ggpht.com/-kKlAb6vTA30/U2A3D-N7kQI/AAAAAAAAC3U/ueW2NAc636U/s1600/r2014_f021_trl.jpg";
const startListUrl = "https://www.leszy.run/events/niebocross-2027/lista";
// The 2027 routes may still change; set to true once they are final.
const showRouteMaps = false;
const rulesUrl = "https://docs.google.com/document/d/1SsR3T1OHH6gGEtjzfcK6-2aVflEK11Mk9idtrbgDk5Y/edit?usp=sharing";
---

<section class="nc-hero relative isolate overflow-hidden bg-[#16224a] text-white">
  <img
    src="/niebocross/2027-crane-light.webp"
    alt=""
    aria-hidden="true"
    class="nc-crane pointer-events-none absolute right-0 top-1/2 hidden w-[480px] max-w-none -translate-y-1/2 select-none lg:block xl:right-0 xl:w-[640px] 2xl:right-[calc(50vw-720px)] 2xl:w-[760px]"
    loading="eager"
  />

  <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-14 lg:pb-24 lg:pt-20">
    <div class="max-w-xl space-y-7 lg:max-w-lg">
      <div class="flex items-center gap-4">
        <div class="flex h-20 w-20 flex-none items-center justify-center rounded-2xl bg-white p-2 shadow-lg shadow-black/30">
          <img src="/niebocross_logo.webp" alt="Logo NieboCross" class="h-full w-full object-contain" loading="eager" />
        </div>
      </div>

      <h1 class="text-5xl font-black uppercase leading-[0.9] tracking-tight sm:text-7xl">
        II {t("niebocross.title")}<br />2027
      </h1>

      <p class="text-xl text-[#cdebf7]">
        {t("niebocross.hero_dedication")} <a href="#memorial-marek" class="underline decoration-[#f7c6a3]/60 underline-offset-4 hover:text-white">{t("niebocross.memorial_person_name")}</a>
      </p>

      <p class="text-lg leading-relaxed text-slate-200">
        {t("niebocross.hero_description")} <a href="#cel-charytatywny" class="font-semibold text-white underline decoration-[#f7c6a3] underline-offset-4 hover:text-[#f7c6a3]">OTOZ Animals</a>.
      </p>

      <dl class="grid grid-cols-3 gap-px overflow-hidden rounded-2xl bg-white/15 ring-1 ring-white/15">
        <div class="bg-[#16224a] px-3 py-3 sm:px-4">
          <dt class="text-sm text-[#cdebf7]">{t("niebocross.date")}</dt>
          <dd class="text-base font-semibold sm:text-lg">{t("niebocross.event_date_short")}</dd>
        </div>
        <div class="bg-[#16224a] px-3 py-3 sm:px-4">
          <dt class="text-sm text-[#cdebf7]">{t("niebocross.place")}</dt>
          <dd class="text-base font-semibold sm:text-lg">Nieborowice</dd>
        </div>
        <div class="bg-[#16224a] px-3 py-3 sm:px-4">
          <dt class="text-sm text-[#cdebf7]">{t("niebocross.routes")}</dt>
          <dd class="text-base font-semibold sm:text-lg">3 km, 9 km</dd>
        </div>
      </dl>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href={registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-[#d9343f] px-7 py-3.5 text-lg font-bold text-white shadow-lg shadow-[#d9343f]/30 transition hover:bg-[#c22a35] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#f7c6a3]"
        >
          {t("niebocross.register_now")}
        </a>
        <a
          href={rulesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border-2 border-white/40 px-5 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/10 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#f7c6a3]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          {t("niebocross.rules_btn")}
        </a>
        <a
          href={startListUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border-2 border-white/40 px-5 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/10 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#f7c6a3]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {t("niebocross.start_list_btn")}
        </a>
      </div>
    </div>

    <img
      src="/niebocross/2027-crane-light.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none mx-auto mt-10 w-full max-w-md select-none lg:hidden"
      loading="lazy"
    />
  </div>
</section>

<section id="dystanse" class="bg-[#e6f4fa]">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-slate-900">{t("niebocross.categories_title")}</h2>
      <p class="mt-3 text-lg text-slate-700">{t("niebocross.two_routes_desc")}</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <article class="rounded-2xl border-t-4 border-[#3f8f5b] bg-white p-6 shadow-sm">
        <p class="text-4xl font-black text-[#16224a]">3 km</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">{t("niebocross.for_beginners")}</h3>
        <p class="mt-3 text-slate-700">{t("niebocross.for_beginners_desc")}</p>
      </article>

      <article class="rounded-2xl border-t-4 border-[#b8256f] bg-white p-6 shadow-sm">
        <p class="text-4xl font-black text-[#16224a]">9 km</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">{t("niebocross.for_challengers")}</h3>
        <p class="mt-3 text-slate-700">{t("niebocross.for_challengers_desc")}</p>
      </article>
    </div>

    <div class="mt-6 rounded-2xl bg-[#16224a] p-6 text-white">
      <h3 class="text-lg font-bold">{t("niebocross.age_rule_title")}</h3>
      <p class="mt-2 text-slate-200">{t("niebocross.age_rule_desc")}</p>
      <p class="mt-2 text-slate-200">
        {t("niebocross.age_rule_minor")} <a href={rulesUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-[#f7c6a3] underline underline-offset-4 hover:text-white">{t("niebocross.age_rule_minor_link")}</a>.
      </p>
    </div>

    <div id="bieg-dla-dzieci" class="mt-12 grid gap-8 md:grid-cols-[1fr_1.2fr] md:items-start">
      <div>
        <h3 class="text-2xl font-bold text-slate-900">{t("niebocross.kids_race_section_title")}</h3>
        <p class="mt-3 text-slate-700">{t("niebocross.kids_race_section_desc")}</p>
        <p class="mt-3 text-slate-700">{t("niebocross.kids_race_guardian")}</p>
      </div>
      <div class="overflow-hidden rounded-2xl bg-white shadow-sm">
        <table class="w-full text-left">
          <thead>
            <tr class="bg-[#16224a] text-white">
              <th scope="col" class="px-6 py-3 text-sm font-semibold">{t("niebocross.kids_race_age")}</th>
              <th scope="col" class="px-6 py-3 text-sm font-semibold">{t("niebocross.kids_race_distance")}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            <tr><td class="px-6 py-3 font-medium">2–5</td><td class="px-6 py-3">100 m</td></tr>
            <tr><td class="px-6 py-3 font-medium">6–8</td><td class="px-6 py-3">200 m</td></tr>
            <tr><td class="px-6 py-3 font-medium">9–11</td><td class="px-6 py-3">400 m</td></tr>
            <tr><td class="px-6 py-3 font-medium">12–15</td><td class="px-6 py-3">800 m</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <p class="mt-10 text-center text-slate-700">{t("niebocross.limit_note")}</p>
  </div>
</section>

<section id="harmonogram" class="mx-auto max-w-6xl px-6 py-16">
  <div class="grid gap-12 lg:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold text-slate-900">{t("niebocross.schedule_title")}</h2>
      <p class="mt-2 text-slate-600">{t("niebocross.event_date_long")}</p>
      <ol class="relative ml-4 mt-8 border-l-2 border-[#cdebf7]">
        <li class="relative pb-7 pl-8">
          <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-[#16224a] bg-white"></span>
          <p class="text-sm font-bold text-[#16224a]">9:30</p>
          <p class="text-slate-700">{t("niebocross.schedule_office_open")}</p>
        </li>
        <li class="relative pb-7 pl-8">
          <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-[#d9343f] bg-white"></span>
          <p class="text-sm font-bold text-[#d9343f]">11:00</p>
          <p class="text-slate-700">{t("niebocross.schedule_kids_registration_close")}</p>
        </li>
        <li class="relative pb-7 pl-8">
          <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-[#16224a]"></span>
          <p class="text-sm font-bold text-[#16224a]">11:20</p>
          <p class="text-slate-700">{t("niebocross.schedule_kids_run")}</p>
        </li>
        <li class="relative pb-7 pl-8">
          <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-[#d9343f] bg-white"></span>
          <p class="text-sm font-bold text-[#d9343f]">11:40</p>
          <p class="text-slate-700">{t("niebocross.schedule_adults_registration_close")}</p>
        </li>
        <li class="relative pl-8">
          <span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full bg-[#16224a]"></span>
          <p class="text-sm font-bold text-[#16224a]">12:00</p>
          <p class="text-slate-700">{t("niebocross.schedule_main_run")}</p>
          <p class="text-sm text-slate-500">{t("niebocross.schedule_desc")}</p>
        </li>
      </ol>
    </div>

    <div class="space-y-4 lg:pt-16">
      <p class="rounded-2xl bg-[#e6f4fa] p-5 text-slate-700">{t("niebocross.packs_note")} <a href="tel:+48784640977" class="font-semibold text-[#16224a] underline underline-offset-4">784 640 977</a>.</p>
      <p class="rounded-2xl bg-[#e6f4fa] p-5 text-slate-700">{t("niebocross.schedule_cups_note")}</p>
      <p class="rounded-2xl bg-[#e6f4fa] p-5 text-slate-700">{t("niebocross.schedule_money_note")}</p>
      <p class="rounded-2xl bg-[#e6f4fa] p-5 text-slate-700">{t("niebocross.schedule_memorial_short")} <a href="#pomnik" class="font-semibold text-[#16224a] underline underline-offset-4 hover:text-[#d9343f]">{t("niebocross.memorial_site_link")}</a>.</p>
    </div>
  </div>
</section>

<section id="partnerzy" class="mx-auto max-w-6xl px-6 pb-16">
  <div class="mb-8 text-center">
    <h2 class="text-3xl font-bold text-slate-900">{t("niebocross.partners")}</h2>
    <p class="mt-3 text-lg text-slate-700">
      {t("niebocross.partners_thanks")}
    </p>
  </div>

  <div class="flex flex-wrap justify-center gap-6">
    <a
      href="https://gratisownia.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="w-full sm:w-80 rounded-3xl border border-slate-200 bg-white p-6 shadow-lg flex flex-col items-center justify-center transition hover:shadow-xl"
    >
      <img
        src="/gratisownia.png"
        alt="Gratisownia.pl"
        class="h-20 w-auto max-w-full object-contain"
        loading="lazy"
      />
    </a>

    <div class="w-full sm:w-80 rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-6 shadow-md flex flex-col items-center justify-center">
      <div class="text-center space-y-3">
        <p class="font-semibold text-slate-700">{t("niebocross.become_partner")}</p>
        <p class="text-sm text-slate-600">
          {t("niebocross.partner_contact")} <a class="font-semibold text-[#16224a] hover:text-[#d9343f]" href="mailto:biuro@zatyrani.pl">{t("common.email")}</a><br/>
          {t("niebocross.or_call")} <a class="font-semibold text-[#16224a] hover:text-[#d9343f]" href="tel:+48784640977">{t("common.phone")}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<section id="oplaty" class="bg-slate-50 border-y border-slate-200">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="text-3xl font-bold text-slate-900">{t("niebocross.fees")}</h2>
    <p class="mt-3 max-w-2xl text-lg text-slate-700">{t("niebocross.fees_desc")}</p>

    <div class="mt-8 grid items-start gap-6 md:grid-cols-[1fr_1fr_1.3fr]">
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <p class="text-5xl font-black text-[#16224a]">60 zł</p>
        <p class="mt-2 font-semibold text-slate-900">{t("niebocross.adult_run")}</p>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <p class="text-5xl font-black text-[#16224a]">20 zł</p>
        <p class="mt-2 font-semibold text-slate-900">{t("niebocross.kids_run_fee")}</p>
      </div>
      <div id="atrakcje" class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <h3 class="font-bold text-slate-900">{t("niebocross.what_you_get")}</h3>
        <ul class="mt-3 space-y-2 text-slate-700">
          <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-[#d9343f]"></span>{t("niebocross.package_medal")}</li>
          <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-[#d9343f]"></span>{t("niebocross.package_water")}</li>
          <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-[#d9343f]"></span>{t("niebocross.package_medical")}</li>
        </ul>
        <p class="mt-4 text-sm text-slate-600">{t("niebocross.prizes_note")}</p>
      </div>
    </div>
  </div>
</section>

<section id="koszulki" class="mx-auto max-w-6xl px-6 py-16">
  <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div class="space-y-4">
      <h2 class="text-3xl font-bold text-slate-900">{t("niebocross.tshirt_title")}</h2>
      <p class="text-lg text-slate-700">{t("niebocross.tshirt_desc")}</p>
      <p class="text-slate-700">{t("niebocross.tshirt_order")}</p>
      <a
        href={registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[#16224a] px-6 py-3 font-semibold text-white transition hover:bg-[#22336b] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#cdebf7]"
      >
        {t("niebocross.tshirt_cta")}
      </a>
    </div>
    <a href="/niebocross/2027-koszulki.webp" target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded-2xl ring-1 ring-slate-200">
      <img src="/niebocross/2027-koszulki.webp" alt={t("niebocross.tshirt_image_alt")} class="w-full" loading="lazy" />
    </a>
  </div>
</section>

{showRouteMaps && (
<section id="mapy-tras" class="mx-auto max-w-6xl px-6 py-12">
  <div class="space-y-6">
    <h2 class="text-3xl font-bold text-slate-900 text-center">{t("niebocross.trail_maps_title")}</h2>
    <p class="text-lg text-slate-700 text-center">
      {t("niebocross.trail_maps_desc")}
    </p>
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="p-4 flex items-center justify-between">
          <p class="text-sm font-semibold uppercase tracking-widest text-[#3f8f5b]">{t("niebocross.trail_map_3km")}</p>
          <a
            href="/niebocross/NieboCross2026-3km.gpx"
            download
            class="inline-flex items-center gap-1 rounded-lg bg-[#3f8f5b] px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-[#357a4d]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            {t("niebocross.download_gpx")}
          </a>
        </div>
        <iframe
          src="https://www.google.com/maps/d/embed?mid=1aHPl-vwy1RmXo250TKnXCzJAHnZNwjY&ll=50.228923935999006%2C18.595678999999983&z=15"
          class="w-full h-80 border-t border-slate-200"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="p-4 flex items-center justify-between">
          <p class="text-sm font-semibold uppercase tracking-widest text-[#b8256f]">{t("niebocross.trail_map_9km")}</p>
          <a
            href="/niebocross/NieboCross2026-9km.gpx"
            download
            class="inline-flex items-center gap-1 rounded-lg bg-[#b8256f] px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-[#9c1f5e]"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            {t("niebocross.download_gpx")}
          </a>
        </div>
        <iframe
          src="https://www.google.com/maps/d/embed?mid=1Lc5ydgjBZWukRoNqYpKLTxECv_B3neY&ll=50.22948368491693%2C18.583337999999987&z=13"
          class="w-full h-80 border-t border-slate-200"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
)}

<section id="biuro-zawodow" class="mx-auto max-w-6xl px-6 py-12">
  <div class="space-y-6">
    <h2 class="text-3xl font-bold text-slate-900 text-center">{t("niebocross.race_office_title")}</h2>
    <p class="text-lg text-slate-700 text-center max-w-3xl mx-auto">
      {t("niebocross.race_office_desc")}
    </p>

    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 flex items-start gap-3 max-w-3xl mx-auto">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <p class="text-amber-800 font-medium">{t("niebocross.race_office_parking_warning")}</p>
    </div>

    <div class="flex items-center justify-center gap-6 text-sm text-slate-600">
      <span class="inline-flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742z" clip-rule="evenodd" />
        </svg>
        {t("niebocross.race_office_map_legend_parking")}
      </span>
      <span class="inline-flex items-center gap-1.5">
