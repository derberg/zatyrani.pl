---
import PageHeader from "../PageHeader.astro";
---

<PageHeader title="Bramka SMS" subtitle="Wewnętrzna brama do wysyłki SMS do członków stowarzyszenia." background="pink" />

<div id="smsApp" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div id="smsLoading" class="text-center text-gray-600 py-8">Ładowanie…</div>

  <div id="smsMain" class="hidden">
    <div
      id="budgetBanner"
      class="sticky top-0 z-20 bg-purple-600 text-white px-4 py-3 rounded-md shadow mb-6 flex items-center justify-between"
    >
      <div>
        <span class="font-semibold">Budżet:</span>
        <span id="budgetUsed">0</span> / <span id="budgetTotal">0</span> SMS
        <span class="opacity-80">·</span>
        <span>pozostało <span id="budgetRemaining">0</span></span>
      </div>
      <button
        id="logoutBtn"
        type="button"
        class="text-sm bg-white/20 hover:bg-white/30 px-3 py-1 rounded"
      >
        Wyloguj
      </button>
    </div>

    <section class="bg-white rounded-md shadow p-4 mb-6">
      <label for="smsBody" class="block font-semibold text-gray-700 mb-2">
        Treść wiadomości
      </label>
      <textarea
        id="smsBody"
        rows="5"
        class="w-full border rounded-md p-3 focus:outline-none focus:ring-2 focus:ring-purple-500"
        placeholder="Wpisz treść SMS-a…"
      ></textarea>
      <div class="mt-2 text-sm text-gray-600 flex flex-wrap gap-x-4 gap-y-1">
        <span><span id="charCount">0</span> znaków</span>
        <span>ta wiadomość = <strong><span id="segCount">0</span></strong> faktycznie wysłanych SMS do jednej osoby</span>
      </div>

      <div
        id="ucs2Warning"
        class="hidden mt-3 border-l-4 border-yellow-500 bg-yellow-50 p-3 rounded"
      >
        <p class="text-sm text-yellow-800">
          ⚠ Twoja wiadomość zawiera polskie znaki — to drożej.
          Teraz: <strong><span id="ucs2Segs">0</span> SMS do jednej osoby</strong>.
          Po usunięciu polskich znaków: <strong><span id="gsmSegs">0</span> SMS do jednej osoby</strong>
          (oszczędność: <strong><span id="savePerRecipient">0</span> SMS na osobę</strong>,
          czyli <strong><span id="saveTotal">0</span> SMS z budżetu</strong> przy obecnym wyborze odbiorców).
        </p>
        <button
          id="stripBtn"
          type="button"
          class="mt-2 bg-yellow-500 hover:bg-yellow-600 text-white text-sm px-3 py-1 rounded"
        >
          Usuń polskie znaki (z <span id="stripBtnFrom">0</span> na <span id="stripBtnTo">0</span> SMS)
        </button>
      </div>
    </section>

    <section class="bg-white rounded-md shadow p-4 mb-6">
      <div class="flex items-center justify-between gap-3 mb-3">
        <div>
          <h2 class="font-semibold text-gray-800">Odbiorcy</h2>
          <div class="text-sm text-gray-600">
            Wybrano <span id="selectedCount">0</span> / <span id="totalCount">0</span>
          </div>
        </div>
        <button
          id="addMemberBtn"
          type="button"
          class="shrink-0 inline-flex items-center gap-1 min-h-[44px] px-4 rounded-md bg-purple-600 hover:bg-purple-700 disabled:bg-gray-400 text-white font-medium"
        >
          <span aria-hidden="true" class="text-xl leading-none">+</span> Dodaj osobę
        </button>
      </div>
      <div class="flex gap-2 mb-3">
        <button
          id="selectAllBtn"
          type="button"
          class="text-sm bg-gray-100 hover:bg-gray-200 px-3 py-1 rounded"
        >
          Zaznacz wszystkich
        </button>
        <button
          id="deselectAllBtn"
          type="button"
          class="text-sm bg-gray-100 hover:bg-gray-200 px-3 py-1 rounded"
        >
          Odznacz wszystkich
        </button>
      </div>
      <ul id="memberList" class="divide-y divide-gray-100 max-h-96 overflow-y-auto"></ul>
    </section>

    <div
      id="totalPanel"
      class="sticky bottom-0 bg-white border-t border-gray-200 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 py-3 shadow-[0_-4px_8px_rgba(0,0,0,0.05)]"
    >
      <div id="totalSummary" class="text-sm text-gray-700 mb-2">
        Wybierz odbiorców i napisz treść.
      </div>
      <div class="flex justify-end">
        <button
          id="sendBtn"
          type="button"
          disabled
          class="bg-purple-600 hover:bg-purple-700 disabled:bg-gray-400 disabled:cursor-not-allowed text-white px-6 py-2 rounded-md"
        >
          Wyślij
        </button>
      </div>
    </div>
  </div>
</div>

<div
  id="confirmModal"
  class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-30"
>
  <div class="bg-white rounded-lg shadow-lg max-w-md w-full mx-4 p-5">
    <h3 class="text-lg font-semibold mb-3">Potwierdź wysyłkę</h3>
    <p id="confirmText" class="text-gray-700 mb-4"></p>
    <div class="flex justify-end gap-2">
      <button
        id="cancelConfirmBtn"
        type="button"
        class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded"
      >
        Anuluj
      </button>
      <button
        id="proceedSendBtn"
        type="button"
        class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded"
      >
        Wyślij
      </button>
    </div>
  </div>
</div>

<div
  id="memberFormModal"
  class="hidden fixed inset-0 bg-black/40 flex items-end sm:items-center justify-center z-40"
>
  <form
    id="memberForm"
    novalidate
    class="bg-white w-full sm:max-w-md sm:mx-4 rounded-t-2xl sm:rounded-lg shadow-lg p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]"
  >
    <h3 id="memberFormTitle" class="text-lg font-semibold mb-4">Dodaj osobę</h3>
    <label for="memberName" class="block font-medium text-gray-700 mb-1">Imię i nazwisko</label>
    <input
      id="memberName"
      name="name"
      type="text"
      maxlength="100"
      autocomplete="off"
      autocapitalize="words"
      enterkeyhint="next"
      class="w-full border rounded-md px-3 py-3 text-base mb-4 focus:outline-none focus:ring-2 focus:ring-purple-500"
    />
    <label for="memberPhone" class="block font-medium text-gray-700 mb-1">Numer telefonu</label>
    <input
      id="memberPhone"
      name="phone"
      type="tel"
      inputmode="tel"
      autocomplete="off"
      enterkeyhint="done"
      placeholder="600 100 200"
      class="w-full border rounded-md px-3 py-3 text-base focus:outline-none focus:ring-2 focus:ring-purple-500"
    />
    <p class="text-xs text-gray-500 mt-1">9 cyfr. Numer zagraniczny wpisz z +, np. +49…</p>
    <p id="memberFormError" class="hidden mt-3 text-sm text-red-700 bg-red-50 border-l-4 border-red-500 p-2 rounded"></p>
    <div class="grid grid-cols-2 gap-2 mt-5">
      <button
        id="cancelMemberFormBtn"
        type="button"
        class="min-h-[48px] bg-gray-100 hover:bg-gray-200 rounded-md font-medium"
      >
        Anuluj
      </button>
      <button
        id="saveMemberBtn"
        type="submit"
        class="min-h-[48px] bg-purple-600 hover:bg-purple-700 disabled:bg-gray-400 text-white rounded-md font-medium"
      >
        Zapisz
      </button>
    </div>
  </form>
</div>

<div
  id="deleteModal"
  class="hidden fixed inset-0 bg-black/40 flex items-end sm:items-center justify-center z-40"
>
  <div class="bg-white w-full sm:max-w-md sm:mx-4 rounded-t-2xl sm:rounded-lg shadow-lg p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
    <h3 class="text-lg font-semibold mb-3">Usunąć osobę?</h3>
    <p class="text-gray-700">
      <strong id="deleteName"></strong> (<span id="deletePhone"></span>) zniknie z listy odbiorców.
    </p>
    <p id="deleteError" class="hidden mt-3 text-sm text-red-700 bg-red-50 border-l-4 border-red-500 p-2 rounded"></p>
    <div class="grid grid-cols-2 gap-2 mt-5">
      <button
        id="cancelDeleteBtn"
        type="button"
        class="min-h-[48px] bg-gray-100 hover:bg-gray-200 rounded-md font-medium"
      >
        Anuluj
      </button>
      <button
        id="confirmDeleteBtn"
        type="button"
        class="min-h-[48px] bg-red-600 hover:bg-red-700 disabled:bg-gray-400 text-white rounded-md font-medium"
      >
        Usuń
      </button>
    </div>
  </div>
</div>

<div
  id="toast"
  role="status"
  class="hidden fixed left-1/2 -translate-x-1/2 top-4 z-50 bg-gray-900 text-white text-sm px-4 py-2 rounded-full shadow-lg max-w-[90vw] text-center"
></div>

<div
  id="summaryModal"
  class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-30"
>
  <div class="bg-white rounded-lg shadow-lg max-w-md w-full mx-4 p-5">
    <h3 class="text-lg font-semibold mb-3">Wysyłka zakończona</h3>
    <p id="summaryText" class="text-gray-700 mb-3"></p>
    <div id="summaryFailed" class="hidden mb-3">
      <p class="text-sm font-semibold text-red-700 mb-1">Nieudane:</p>
      <ul id="failedList" class="text-sm text-red-700 list-disc pl-5"></ul>
    </div>
    <div class="flex justify-end">
      <button
        id="closeSummaryBtn"
        type="button"
        class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded"
      >
        OK
      </button>
    </div>
  </div>
</div>

<script>
  import { encoding, segments, transliterate } from "../../utils/sms-segments.js";

  type Member = { id: string; name: string; phone: string };
  type Budget = { total: number; used: number; remaining: number };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const state: {
    members: Member[];
    selected: Set<string>;
    budget: Budget;
    sending: boolean;
    meId: string | null;
    editingId: string | null;
    deletingId: string | null;
  } = {
    members: [],
    selected: new Set(),
    budget: { total: 0, used: 0, remaining: 0 },
    sending: false,
    meId: null,
    editingId: null,
    deletingId: null,
  };

  const PENCIL_ICON = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>`;
  const TRASH_ICON = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>`;

  function escapeHtml(s: string) {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function renderBudget() {
    $("budgetTotal").textContent = String(state.budget.total);
    $("budgetUsed").textContent = String(state.budget.used);
    $("budgetRemaining").textContent = String(
      Math.max(0, state.budget.total - state.budget.used)
    );
  }

  function renderMembers() {
    const list = $<HTMLUListElement>("memberList");
    list.innerHTML = "";
    for (const m of state.members) {
      const li = document.createElement("li");
      li.className = "flex items-center gap-1";
      li.dataset.recipient = m.id;
      const id = escapeHtml(m.id);
      const name = escapeHtml(m.name);
      const deleteBtn =
        m.id === state.meId
          ? `<span class="h-11 w-11 shrink-0"></span>`
          : `<button type="button" class="member-action member-delete h-11 w-11 shrink-0 inline-flex items-center justify-center rounded-md text-gray-500 hover:text-red-600 hover:bg-red-50 disabled:opacity-40" data-id="${id}" aria-label="Usuń ${name}" title="Usuń">${TRASH_ICON}</button>`;
      li.innerHTML = `
        <label class="flex-1 min-w-0 flex items-center gap-3 py-2 cursor-pointer">
          <input type="checkbox" class="recipient-cb h-5 w-5 shrink-0" data-id="${id}" ${state.selected.has(m.id) ? "checked" : ""} />
          <div class="min-w-0">
            <div class="font-medium text-gray-800 truncate">${name}</div>
            <div class="text-xs text-gray-500">${escapeHtml(m.phone)}</div>
          </div>
        </label>
        <div class="recipient-status text-sm text-gray-400 hidden" data-status="${id}"></div>
        <button type="button" class="member-action member-edit h-11 w-11 shrink-0 inline-flex items-center justify-center rounded-md text-gray-500 hover:text-purple-700 hover:bg-purple-50 disabled:opacity-40" data-id="${id}" aria-label="Edytuj ${name}" title="Edytuj">${PENCIL_ICON}</button>
        ${deleteBtn}
      `;
      list.appendChild(li);
    }
    list.querySelectorAll<HTMLButtonElement>(".member-edit").forEach((btn) => {
      btn.addEventListener("click", () => openMemberForm(btn.dataset.id!));
    });
    list.querySelectorAll<HTMLButtonElement>(".member-delete").forEach((btn) => {
      btn.addEventListener("click", () => openDeleteModal(btn.dataset.id!));
    });
    list.querySelectorAll<HTMLInputElement>(".recipient-cb").forEach((cb) => {
      cb.addEventListener("change", () => {
        const id = cb.dataset.id!;
        if (cb.checked) state.selected.add(id);
        else state.selected.delete(id);
        renderTotals();
      });
    });
    $("totalCount").textContent = String(state.members.length);
  }

  function setRecipientStatus(
    id: string,
    text: string,
    color: "gray" | "green" | "red"
  ) {
    const el = document.querySelector<HTMLElement>(`[data-status="${id}"]`);
    if (!el) return;
    el.classList.remove("hidden");
    el.classList.remove("text-gray-400", "text-green-600", "text-red-600");
    el.classList.add(
      color === "green"
        ? "text-green-600"
        : color === "red"
          ? "text-red-600"
          : "text-gray-400"
    );
    el.textContent = text;
  }

  function renderCounter() {
    const body = $<HTMLTextAreaElement>("smsBody").value;
    const enc = encoding(body);
    const segs = segments(body);
    $("charCount").textContent = String(body.length);
    $("segCount").textContent = String(segs);

    const warning = $("ucs2Warning");
    if (enc === "UCS-2" && body.length > 0) {
      const stripped = transliterate(body);
      const gsmSegs = segments(stripped);
      const saved = Math.max(0, segs - gsmSegs);
      $("ucs2Segs").textContent = String(segs);
      $("gsmSegs").textContent = String(gsmSegs);
      $("savePerRecipient").textContent = String(saved);
      $("saveTotal").textContent = String(saved * state.selected.size);
      $("stripBtnFrom").textContent = String(segs);
      $("stripBtnTo").textContent = String(gsmSegs);
      warning.classList.remove("hidden");
    } else {
      warning.classList.add("hidden");
    }
  }

  function renderTotals() {
    const body = $<HTMLTextAreaElement>("smsBody").value;
    const segs = segments(body);
    const k = state.selected.size;
    const total = segs * k;
    const remaining = Math.max(0, state.budget.total - state.budget.used);

    $("selectedCount").textContent = String(k);

    const summary = $("totalSummary");
    if (k === 0 || body.length === 0) {
      summary.textContent = "Wybierz odbiorców i napisz treść.";
      summary.classList.remove("text-red-600", "font-semibold");
    } else {
      const after = remaining - total;
      summary.innerHTML = `Wybrano <strong>${k}</strong> odbiorców · ta wiadomość = <strong>${segs}</strong> SMS do jednej osoby · razem <strong>${k} × ${segs} = ${total}</strong> SMS · po wysłaniu pozostanie <strong>${Math.max(0, after)}</strong> z budżetu`;
      if (total > remaining) {
        summary.classList.add("text-red-600", "font-semibold");
      } else {
        summary.classList.remove("text-red-600", "font-semibold");
      }
    }

    const sendBtn = $<HTMLButtonElement>("sendBtn");
    sendBtn.disabled =
      state.sending ||
      k === 0 ||
      body.length === 0 ||
      total > remaining ||
      total === 0;

    renderCounter();
  }

  async function loadState() {
    try {
      const res = await fetch("/api/sms-gate/state", { credentials: "same-origin" });
      if (res.status === 401 || res.status === 403) {
        window.location.href = "/?access_denied=true";
        return;
      }
      if (!res.ok) {
        $("smsLoading").textContent = "Błąd ładowania. Odśwież stronę.";
        return;
      }
      const data = await res.json();
      state.members = data.members || [];
      state.meId = data.meId || null;
      const visibleIds = new Set(state.members.map((m) => m.id));
      state.selected = new Set([...state.selected].filter((id) => visibleIds.has(id)));
      state.budget = data.budget || { total: 0, used: 0, remaining: 0 };
      $("smsLoading").classList.add("hidden");
      $("smsMain").classList.remove("hidden");
      renderBudget();
      renderMembers();
      renderTotals();
    } catch (e) {
      console.error(e);
      $("smsLoading").textContent = "Błąd połączenia. Odśwież stronę.";
    }
  }

  function setControlsDisabled(disabled: boolean) {
    state.sending = disabled;
    $<HTMLTextAreaElement>("smsBody").disabled = disabled;
    document
      .querySelectorAll<HTMLInputElement>(".recipient-cb")
      .forEach((cb) => (cb.disabled = disabled));
    $<HTMLButtonElement>("selectAllBtn").disabled = disabled;
    $<HTMLButtonElement>("deselectAllBtn").disabled = disabled;
    $<HTMLButtonElement>("stripBtn").disabled = disabled;
    $<HTMLButtonElement>("sendBtn").disabled = disabled;
    $<HTMLButtonElement>("addMemberBtn").disabled = disabled;
    document
      .querySelectorAll<HTMLButtonElement>(".member-action")
      .forEach((btn) => (btn.disabled = disabled));
  }

  let toastTimer: number | undefined;
  function showToast(text: string) {
    const toast = $("toast");
    toast.textContent = text;
    toast.classList.remove("hidden");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.add("hidden"), 3000);
  }

  function showInlineError(id: string, text: string) {
    const el = $(id);
    el.textContent = text;
    el.classList.toggle("hidden", !text);
  }

  async function callMembersApi(method: "POST" | "PATCH" | "DELETE", id: string | null, payload?: object) {
    const url = id ? `/api/sms-gate/members?id=${encodeURIComponent(id)}` : "/api/sms-gate/members";
    try {
      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: payload ? JSON.stringify(payload) : undefined,
      });
      if (res.status === 401) {
        window.location.href = "/?access_denied=true";
        return null;
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) return { error: data.error || `Błąd (HTTP ${res.status}). Spróbuj ponownie.` };
      return { data };
    } catch {
      return { error: "Błąd połączenia. Sprawdź internet i spróbuj ponownie." };
    }
  }

  function openMemberForm(id: string | null) {
    const member = id ? state.members.find((m) => m.id === id) : null;
    state.editingId = member ? member.id : null;
    $("memberFormTitle").textContent = member ? "Edytuj osobę" : "Dodaj osobę";
    $<HTMLInputElement>("memberName").value = member ? member.name : "";
    $<HTMLInputElement>("memberPhone").value = member ? member.phone : "";
    showInlineError("memberFormError", "");
    $<HTMLButtonElement>("saveMemberBtn").disabled = false;
    $<HTMLButtonElement>("saveMemberBtn").textContent = "Zapisz";
    $("memberFormModal").classList.remove("hidden");
    $<HTMLInputElement>("memberName").focus();
  }

  function closeMemberForm() {
    $("memberFormModal").classList.add("hidden");
    state.editingId = null;
  }

  async function saveMember(e: Event) {
    e.preventDefault();
    const saveBtn = $<HTMLButtonElement>("saveMemberBtn");
    if (saveBtn.disabled) return;
    const name = $<HTMLInputElement>("memberName").value.trim();
    const phone = $<HTMLInputElement>("memberPhone").value.trim();
    if (!name) {
      showInlineError("memberFormError", "Podaj imię i nazwisko.");
      $<HTMLInputElement>("memberName").focus();
      return;
    }
    if (!phone) {
      showInlineError("memberFormError", "Podaj numer telefonu.");
      $<HTMLInputElement>("memberPhone").focus();
      return;
    }

    showInlineError("memberFormError", "");
    saveBtn.disabled = true;
    saveBtn.textContent = "Zapisywanie…";
    const editingId = state.editingId;
    const result = await callMembersApi(editingId ? "PATCH" : "POST", editingId, { name, phone });
    if (!result) return;
    if (result.error) {
      showInlineError("memberFormError", result.error);
      saveBtn.disabled = false;
      saveBtn.textContent = "Zapisz";
      return;
    }

    closeMemberForm();
    const saved = result.data.member as Member;
    showToast(
      editingId
        ? `Zapisano: ${saved.name}`
        : result.data.restored
          ? `Przywrócono: ${saved.name}`
          : `Dodano: ${saved.name}`
    );
    await loadState();
  }

  function openDeleteModal(id: string) {
    const member = state.members.find((m) => m.id === id);
    if (!member) return;
    state.deletingId = id;
    $("deleteName").textContent = member.name;
    $("deletePhone").textContent = member.phone;
    showInlineError("deleteError", "");
    $<HTMLButtonElement>("confirmDeleteBtn").disabled = false;
    $<HTMLButtonElement>("confirmDeleteBtn").textContent = "Usuń";
    $("deleteModal").classList.remove("hidden");
  }

  function closeDeleteModal() {
    $("deleteModal").classList.add("hidden");
    state.deletingId = null;
  }

  async function confirmDelete() {
    const id = state.deletingId;
    const btn = $<HTMLButtonElement>("confirmDeleteBtn");
    if (!id || btn.disabled) return;
    const member = state.members.find((m) => m.id === id);
    btn.disabled = true;
    btn.textContent = "Usuwanie…";
    const result = await callMembersApi("DELETE", id);
    if (!result) return;
    if (result.error) {
      showInlineError("deleteError", result.error);
      btn.disabled = false;
      btn.textContent = "Usuń";
      return;
    }
    closeDeleteModal();
    state.selected.delete(id);
    showToast(`Usunięto: ${member ? member.name : ""}`);
    await loadState();
  }

  async function runSend() {
    const body = $<HTMLTextAreaElement>("smsBody").value;
    const recipients = state.members.filter((m) => state.selected.has(m.id));
    const byId = new Map(recipients.map((m) => [m.id, m]));
    setControlsDisabled(true);

    // The server now loops through all recipients in a single request, so
    // closing the browser tab can no longer interrupt a send mid-way.
    for (const r of recipients) setRecipientStatus(r.id, "wysyłanie…", "gray");

    let sent = 0;
    let failed = 0;
    const failedRows: { name: string; phone: string; reason: string }[] = [];
    let budgetExhausted = false;

    try {
      const res = await fetch("/api/sms-gate/send", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({ recipientIds: recipients.map((m) => m.id), body }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        const reason = data.error || `HTTP ${res.status}`;
        for (const r of recipients) {
          setRecipientStatus(r.id, "✗ błąd", "red");
          failedRows.push({ name: r.name, phone: r.phone, reason });
        }
        failed = recipients.length;
      } else {
        if (typeof data.used === "number") {
          state.budget.used = data.used;
          renderBudget();
        }
        budgetExhausted = Boolean(data.budgetExceeded);

        for (const result of data.results || []) {
          const r = byId.get(result.recipientId);
          if (!r) continue;
          if (result.status === "sent") {
            sent++;
            setRecipientStatus(r.id, "✓ wysłano", "green");
          } else if (result.status === "skipped") {
            const label =
              result.reason === "budget_exceeded"
                ? "budżet wyczerpany"
                : "pominięto";
            setRecipientStatus(r.id, label, "red");
          } else {
            failed++;
            const reason = result.error || "błąd";
            failedRows.push({ name: r.name, phone: r.phone, reason });
            setRecipientStatus(r.id, "✗ błąd", "red");
          }
        }
      }
    } catch (e) {
      const reason = e instanceof Error ? e.message : "błąd połączenia";
      for (const r of recipients) {
        setRecipientStatus(r.id, "✗ błąd sieci", "red");
        failedRows.push({ name: r.name, phone: r.phone, reason });
      }
      failed = recipients.length;
    }

    setControlsDisabled(false);
    renderTotals();
    showSummary(sent, failed, failedRows, budgetExhausted, recipients.length);
  }

  function showSummary(
    sent: number,
    failed: number,
    failedRows: { name: string; phone: string; reason: string }[],
    budgetExhausted: boolean,
    requested: number
  ) {
    const skipped = budgetExhausted ? requested - sent - failed : 0;
    const lines: string[] = [];
    lines.push(`Wysłano: ${sent}`);
    if (failed > 0) lines.push(`Błędy: ${failed}`);
    if (skipped > 0) lines.push(`Pominięto (budżet wyczerpany): ${skipped}`);
    $("summaryText").textContent = lines.join(" · ");

    const failedSection = $("summaryFailed");
    const failedList = $<HTMLUListElement>("failedList");
    failedList.innerHTML = "";
    if (failedRows.length > 0) {
      for (const f of failedRows) {
        const li = document.createElement("li");
        li.textContent = `${f.name} (${f.phone}) — ${f.reason}`;
        failedList.appendChild(li);
      }
      failedSection.classList.remove("hidden");
    } else {
      failedSection.classList.add("hidden");
    }
    $("summaryModal").classList.remove("hidden");
  }

  // Wire up events
  document.addEventListener("DOMContentLoaded", () => {
    $<HTMLTextAreaElement>("smsBody").addEventListener("input", renderTotals);

    $("selectAllBtn").addEventListener("click", () => {
      state.selected = new Set(state.members.map((m) => m.id));
      document
        .querySelectorAll<HTMLInputElement>(".recipient-cb")
        .forEach((cb) => (cb.checked = true));
      renderTotals();
    });

    $("deselectAllBtn").addEventListener("click", () => {
      state.selected.clear();
      document
        .querySelectorAll<HTMLInputElement>(".recipient-cb")
        .forEach((cb) => (cb.checked = false));
      renderTotals();
    });

    $("stripBtn").addEventListener("click", () => {
      const ta = $<HTMLTextAreaElement>("smsBody");
      ta.value = transliterate(ta.value);
      renderTotals();
    });

    $("sendBtn").addEventListener("click", () => {
      const body = $<HTMLTextAreaElement>("smsBody").value;
      const segs = segments(body);
      const k = state.selected.size;
      const total = segs * k;
      $("confirmText").textContent = `Wysłać do ${k} osób, łącznie ${total} SMS?`;
      $("confirmModal").classList.remove("hidden");
    });

    $("cancelConfirmBtn").addEventListener("click", () => {
      $("confirmModal").classList.add("hidden");
    });

    $("proceedSendBtn").addEventListener("click", () => {
      $("confirmModal").classList.add("hidden");
      runSend();
    });

    $("addMemberBtn").addEventListener("click", () => openMemberForm(null));
    $("memberForm").addEventListener("submit", saveMember);
    $("cancelMemberFormBtn").addEventListener("click", closeMemberForm);
    $("memberName").addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        $<HTMLInputElement>("memberPhone").focus();
      }
    });
    $("cancelDeleteBtn").addEventListener("click", closeDeleteModal);
    $("confirmDeleteBtn").addEventListener("click", confirmDelete);

    // Tapping the dimmed backdrop or pressing Escape closes the member dialogs.
    $("memberFormModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeMemberForm();
    });
    $("deleteModal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeDeleteModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      closeMemberForm();
      closeDeleteModal();
    });

    $("closeSummaryBtn").addEventListener("click", () => {
      $("summaryModal").classList.add("hidden");
    });

    $("logoutBtn").addEventListener("click", async () => {
      try {
        await fetch("/api/auth/logout", {
          method: "POST",
          credentials: "same-origin",
        });
      } catch {
        // ignore
      }
      try {
        window.localStorage.removeItem("authState");
      } catch {
        // ignore
      }
      window.location.href = "/";
    });

    loadState();
  });
</script>
