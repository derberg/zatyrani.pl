---
import PageHeader from "../PageHeader.astro";
import { ACHIEVEMENT_MAX_LENGTH, PLEBISCYT } from "../../utils/plebiscyt.js";
---

<PageHeader title="Plebiscyt 2026" subtitle="Wybierz Zatyranego Roku i pochwal się swoim sezonem." background="pink" />

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div id="plebLoading" class="text-center text-gray-600 py-8">Ładowanie…</div>

  <div id="plebMain" class="hidden">
    <div class="sticky top-0 z-20 bg-purple-600 text-white px-4 py-3 rounded-md shadow mb-6 flex items-center justify-between gap-3">
      <div class="min-w-0">Zalogowano jako <span id="meName" class="font-semibold"></span></div>
      <button
        id="logoutBtn"
        type="button"
        class="shrink-0 text-sm bg-white/20 hover:bg-white/30 px-3 py-1 rounded"
      >
        Wyloguj
      </button>
    </div>

    <p id="deadlineInfo" class="text-sm text-gray-600 mb-4">
      Głosowanie trwa do {PLEBISCYT.closesLabel} włącznie. Do tego czasu możesz zmienić swoją odpowiedź.
    </p>

    <form id="plebForm" class="hidden" novalidate>
      {PLEBISCYT.categories.map((c) => (
        <section class="bg-white rounded-md shadow p-4 mb-6">
          <label for={`vote-${c.key}`} class="block font-semibold text-gray-700 mb-1">{c.label}</label>
          <p class="text-sm text-gray-600 mb-3">{c.hint}</p>
          <select
            id={`vote-${c.key}`}
            data-category={c.key}
            class="vote-select w-full border rounded-md px-3 py-3 text-base bg-white focus:outline-none focus:ring-2 focus:ring-purple-500"
          >
            <option value="">— wybierz osobę —</option>
          </select>
        </section>
      ))}

      <section class="bg-white rounded-md shadow p-4 mb-6">
        <label for="achievement" class="block font-semibold text-gray-700 mb-1">Opisz swoje osiągnięcie w tym roku</label>
        <p class="text-sm text-gray-600 mb-3">Z czego jesteś najbardziej dumny/dumna, jeśli chodzi o sport w 2026? To pole nie jest obowiązkowe.</p>

        <div class="border-l-4 border-purple-500 bg-purple-50 p-3 rounded mb-3">
          <p class="text-sm font-semibold text-purple-900 mb-1">💡 Podpowiedź</p>
          <p class="text-sm text-purple-900 mb-1">Nie musi to być podium. Liczy się to, co dla Ciebie było ważne, na przykład:</p>
          <ul class="text-sm text-purple-900 list-disc pl-5 space-y-0.5">
            <li>nowa życiówka: „pierwszy raz złamałem 50 minut na 10 km”</li>
            <li>pierwszy start na nowym dystansie: „ukończyłam pierwszy półmaraton”</li>
            <li>wygrana albo podium: „2. miejsce w kategorii na Wilczym Półmaratonie”</li>
            <li>regularność: „biegałam co tydzień przez cały rok, nawet zimą”</li>
            <li>powrót po kontuzji, pierwszy ultra, nowa dyscyplina (NW, canicross, rower…)</li>
          </ul>
        </div>

        <textarea
          id="achievement"
          rows="6"
          maxlength={ACHIEVEMENT_MAX_LENGTH}
          class="w-full border rounded-md p-3 text-base focus:outline-none focus:ring-2 focus:ring-purple-500"
          placeholder="Napisz kilka zdań o swoim sezonie…"
        ></textarea>
        <div class="mt-1 text-xs text-gray-500 text-right">
          <span id="charCount">0</span> / {ACHIEVEMENT_MAX_LENGTH} znaków
        </div>
      </section>

      <p id="formError" class="hidden mb-4 text-sm text-red-700 bg-red-50 border-l-4 border-red-500 p-2 rounded"></p>

      <div class="flex justify-end gap-2">
        <button
          id="cancelEditBtn"
          type="button"
          class="hidden min-h-[48px] bg-gray-100 hover:bg-gray-200 px-6 rounded-md font-medium"
        >
          Anuluj
        </button>
        <button
          id="saveBtn"
          type="submit"
          class="min-h-[48px] flex-1 sm:flex-none bg-purple-600 hover:bg-purple-700 disabled:bg-gray-400 text-white px-8 py-2 rounded-md font-medium"
        >
          Wyślij
        </button>
      </div>
    </form>

    <div id="plebSummary" class="hidden">
      <section id="thanksBox" class="bg-white rounded-md shadow p-6 mb-6 text-center">
        <div class="text-4xl mb-2" aria-hidden="true">🏆</div>
        <h2 id="thanksTitle" class="text-xl font-semibold text-gray-800 mb-2">Dzięki, Twoja odpowiedź jest zapisana!</h2>
        <p id="thanksText" class="text-gray-600">Wyniki ogłosimy po zakończeniu głosowania.</p>
      </section>
      <section class="bg-white rounded-md shadow p-4 mb-6">
        <dl id="summaryList"></dl>
        <div class="flex justify-end mt-4">
          <button
            id="editBtn"
            type="button"
            class="text-sm bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded"
          >
            Zmień odpowiedź
          </button>
        </div>
      </section>
    </div>
  </div>
</div>

<script>
  import { PLEBISCYT } from "../../utils/plebiscyt.js";

  type Candidate = { id: string; name: string };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const state: {
    candidates: Candidate[];
    votes: Record<string, string>;
    achievement: string;
    closed: boolean;
  } = { candidates: [], votes: {}, achievement: "", closed: false };

  function escapeHtml(s: string) {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function hasAnswer() {
    return Boolean(state.achievement) || Object.values(state.votes).some(Boolean);
  }

  function selects() {
    return document.querySelectorAll<HTMLSelectElement>(".vote-select");
  }

  function fillForm() {
    for (const select of selects()) {
      select.innerHTML =
        `<option value="">— wybierz osobę —</option>` +
        state.candidates
          .map((c) => `<option value="${escapeHtml(c.id)}">${escapeHtml(c.name)}</option>`)
          .join("");
      select.value = state.votes[select.dataset.category || ""] || "";
    }
    $<HTMLTextAreaElement>("achievement").value = state.achievement;
    renderCounter();
  }

  function renderCounter() {
    $("charCount").textContent = String($<HTMLTextAreaElement>("achievement").value.length);
  }

  function renderSummary() {
    const nameOf = (id: string) => state.candidates.find((c) => c.id === id)?.name || "—";
    const rows = PLEBISCYT.categories.map(
      (c) => `
        <dt class="text-sm text-gray-500 mb-1">${escapeHtml(c.label)}</dt>
        <dd class="font-semibold text-gray-800 mb-4">${state.votes[c.key] ? escapeHtml(nameOf(state.votes[c.key])) : "—"}</dd>`
    );
    rows.push(`
      <dt class="text-sm text-gray-500 mb-1">Twoje osiągnięcie</dt>
      <dd class="text-gray-800 whitespace-pre-line">${state.achievement ? escapeHtml(state.achievement) : "—"}</dd>`);
    $("summaryList").innerHTML = rows.join("");
  }

  function showForm() {
    fillForm();
    showInlineError("");
    $("plebSummary").classList.add("hidden");
    $("plebForm").classList.remove("hidden");
    $("cancelEditBtn").classList.toggle("hidden", !hasAnswer());
  }

  function showSummary() {
    renderSummary();
    $("plebForm").classList.add("hidden");
    $("plebSummary").classList.remove("hidden");
    $("editBtn").classList.toggle("hidden", state.closed);
    $("thanksBox").classList.toggle("hidden", !hasAnswer());
    if (state.closed) {
      $("thanksTitle").textContent = "Głosowanie zakończone";
      $("thanksText").textContent = "Dziękujemy! Wyniki wkrótce.";
      $("thanksBox").classList.remove("hidden");
    }
  }

  function showInlineError(text: string) {
    const el = $("formError");
    el.textContent = text;
    el.classList.toggle("hidden", !text);
  }

  async function loadState() {
    try {
      const res = await fetch("/api/plebiscyt/state", { credentials: "same-origin" });
      if (res.status === 401) {
        // /zaloguj sends the user back to the last visited page, i.e. here.
        window.location.href = "/zaloguj";
        return;
      }
      if (!res.ok) {
        $("plebLoading").textContent = "Błąd ładowania. Odśwież stronę.";
        return;
      }
      const data = await res.json();
      state.candidates = data.candidates || [];
      state.votes = data.votes || {};
      state.achievement = data.achievement || "";
      state.closed = Boolean(data.closed);
      $("meName").textContent = data.me?.name || "";
      $("plebLoading").classList.add("hidden");
      $("plebMain").classList.remove("hidden");
      if (state.closed) {
        $("deadlineInfo").classList.add("hidden");
        showSummary();
      } else if (hasAnswer()) {
        showSummary();
      } else {
        showForm();
      }
    } catch (e) {
      console.error(e);
      $("plebLoading").textContent = "Błąd połączenia. Odśwież stronę.";
    }
  }

  async function save(event: Event) {
    event.preventDefault();
    const votes: Record<string, string> = {};
    for (const select of selects()) votes[select.dataset.category || ""] = select.value;
    const achievement = $<HTMLTextAreaElement>("achievement").value.trim();

    if (!achievement && Object.values(votes).every((id) => !id)) {
      showInlineError("Wybierz osobę albo opisz swoje osiągnięcie.");
      return;
    }

    const saveBtn = $<HTMLButtonElement>("saveBtn");
    saveBtn.disabled = true;
    saveBtn.textContent = "Zapisywanie…";
    showInlineError("");
    try {
      const res = await fetch("/api/plebiscyt/vote", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({ votes, achievement }),
      });
      if (res.status === 401) {
        window.location.href = "/zaloguj";
        return;
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showInlineError(data.error || `Błąd (HTTP ${res.status}). Spróbuj ponownie.`);
        return;
      }
      state.votes = data.votes || votes;
      state.achievement = data.achievement ?? achievement;
      showSummary();
      window.scrollTo({ top: 0, behavior: "smooth" });
    } catch {
      showInlineError("Błąd połączenia. Sprawdź internet i spróbuj ponownie.");
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Wyślij";
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    $("plebForm").addEventListener("submit", save);
    $("achievement").addEventListener("input", renderCounter);
    $("editBtn").addEventListener("click", showForm);
    $("cancelEditBtn").addEventListener("click", showSummary);

    $("logoutBtn").addEventListener("click", async () => {
      try {
        await fetch("/api/auth/logout", {
          method: "POST",
          credentials: "same-origin",
        });
      } catch {
        // ignore
      }
      try {
        window.localStorage.removeItem("authState");
      } catch {
        // ignore
      }
      window.location.href = "/";
    });

    loadState();
  });
</script>
