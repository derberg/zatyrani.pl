---
import results from "../../data/wilczy-polmaraton-results-2026.json";

interface Props {
  t: (key: string) => string;
}
const { t } = Astro.props;

const liveResultsUrl = "https://leszy.run/events/wilczy-pmaraton/results";
const medalClasses: Record<number, string> = {
  1: "bg-amber-400 text-amber-950",
  2: "bg-slate-300 text-slate-800",
  3: "bg-orange-300 text-orange-950",
};
const isPodium = (place: number | null) => place !== null && place <= 3;
const genders = ["K", "M"].map((gender) => ({
  gender,
  groups: results.groups.filter((g) => g.gender === gender),
}));
---

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-12">
  <div class="mb-6 text-center">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">{t("wilczypolmaraton.results.title")}</h2>
    <p class="mt-2 text-sm text-slate-600">
      {t("wilczypolmaraton.results.description")}
    </p>
    <p class="mt-1 text-xs text-slate-500">
      {t("wilczypolmaraton.results.updated_at")} {results.updatedAt}
    </p>
    <a
      href={liveResultsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700 underline hover:text-emerald-800"
    >
      {t("wilczypolmaraton.results.full_results_link")} →
    </a>
  </div>

  <!-- View: podium / everyone -->
  <div class="mb-4 grid grid-cols-2 rounded-full bg-slate-100 p-1 text-sm font-semibold" role="tablist">
    <button type="button" data-view="podium" class="view-btn rounded-full px-4 py-2 transition">
      🏆 {t("wilczypolmaraton.results.view_podium")}
    </button>
    <button type="button" data-view="all" class="view-btn rounded-full px-4 py-2 transition">
      {t("wilczypolmaraton.results.view_all")}
    </button>
  </div>

  <!-- Gender -->
  <div class="mb-6 grid grid-cols-2 gap-2" role="tablist">
    {genders.map(({ gender }) => (
      <button
        type="button"
        data-gender={gender}
        class="gender-btn rounded-full border border-emerald-600 px-4 py-2 text-sm font-semibold transition"
      >
        {t(`wilczypolmaraton.results.gender_${gender}`)}
      </button>
    ))}
  </div>

  {genders.map(({ gender, groups }) => (
    <section data-gender-panel={gender} class="gender-panel hidden space-y-6">
      <nav
        class="all-only sticky top-0 z-10 -mx-4 flex gap-2 overflow-x-auto border-b border-slate-200 bg-white/95 px-4 py-2 backdrop-blur sm:mx-0 sm:justify-center sm:rounded-full sm:border sm:px-2"
        aria-label={t("wilczypolmaraton.results.jump_to_group")}
      >
        {groups.map((group) => (
          <a
            href={`#g-${gender}-${group.age}`}
            data-jump={`g-${gender}-${group.age}`}
            class="shrink-0 rounded-full bg-slate-100 px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-emerald-100 hover:text-emerald-800"
          >
            {gender}{group.age}
          </a>
        ))}
      </nav>
      {groups.map((group) => (
        <div
          id={`g-${gender}-${group.age}`}
          class="age-group scroll-mt-16 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"
          data-has-podium={group.participants.some((p) => isPodium(p.place)) ? "true" : "false"}
        >
          <h3 class="flex items-baseline justify-between bg-slate-50 px-4 py-3 font-bold text-slate-900">
            <span>{t(`wilczypolmaraton.results.gender_${gender}`)} {group.age}</span>
            <span class="all-only text-xs font-normal text-slate-500">
              {group.participants.length} {t("wilczypolmaraton.results.participants_count")}
            </span>
          </h3>
          <ol class="divide-y divide-slate-100">
            {group.participants.map((p) => (
              <li class:list={["result-row flex items-center gap-3 px-4 py-3", !isPodium(p.place) && "all-only"]}>
                <span
                  class:list={[
                    "flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm font-bold",
                    medalClasses[p.place ?? 0] ?? (p.place ? "bg-slate-100 text-slate-700" : "bg-transparent text-slate-300"),
                  ]}
                >
                  {p.place ?? "–"}
                </span>
                <div class="min-w-0 flex-1">
                  <p class="truncate font-semibold text-slate-900">{p.name}</p>
                  <p class="truncate text-xs text-slate-500">
                    #{p.bib} · {p.birthYear}{p.club && ` · ${p.club}`}
                  </p>
                </div>
                <div class="shrink-0 text-right">
                  {p.gross ? (
                    <>
                      <p class="font-mono text-base font-semibold tabular-nums text-slate-900">{p.gross}</p>
                      <p class="font-mono text-[11px] tabular-nums text-slate-500">
                        {t("wilczypolmaraton.results.net")} {p.net}
                      </p>
                    </>
                  ) : (
                    <span
                      class:list={[
                        "rounded-full px-2 py-1 text-xs font-semibold",
                        p.status === "on_course" ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500",
                      ]}
                    >
                      {t(`wilczypolmaraton.results.status_${p.status}`)}
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>
  ))}

  <p class="mt-6 text-center text-xs text-slate-500">{t("wilczypolmaraton.results.ranking_note")}</p>
</div>

<script>
  const state = { view: "podium", gender: "K" };
  try {
    const saved = new URLSearchParams(location.hash.slice(1));
    if (saved.get("view") === "all") state.view = "all";
    if (saved.get("gender") === "M") state.gender = "M";
  } catch {
    // Malformed hash: keep the defaults.
  }

  const activeBtn = ["bg-emerald-600", "text-white", "shadow"];
  const inactiveGenderBtn = ["bg-white", "text-emerald-700"];

  function render() {
    document.querySelectorAll<HTMLButtonElement>(".view-btn").forEach((btn) => {
      const on = btn.dataset.view === state.view;
      btn.classList.toggle("bg-white", on);
      btn.classList.toggle("text-slate-900", on);
      btn.classList.toggle("shadow", on);
      btn.classList.toggle("text-slate-600", !on);
      btn.setAttribute("aria-selected", String(on));
    });
    document.querySelectorAll<HTMLButtonElement>(".gender-btn").forEach((btn) => {
      const on = btn.dataset.gender === state.gender;
      activeBtn.forEach((c) => btn.classList.toggle(c, on));
      inactiveGenderBtn.forEach((c) => btn.classList.toggle(c, !on));
      btn.setAttribute("aria-selected", String(on));
    });
    const podium = state.view === "podium";
    document.querySelectorAll<HTMLElement>(".gender-panel").forEach((panel) => {
      panel.classList.toggle("hidden", panel.dataset.genderPanel !== state.gender);
      panel.querySelectorAll<HTMLElement>(".all-only").forEach((el) => el.classList.toggle("hidden", podium));
      panel.querySelectorAll<HTMLElement>(".age-group").forEach((g) =>
        g.classList.toggle("hidden", podium && g.dataset.hasPodium !== "true"));
    });
    history.replaceState(null, "", `#view=${state.view}&gender=${state.gender}`);
  }

  // Jump links scroll without touching the hash, which holds the view state.
  document.querySelectorAll<HTMLAnchorElement>("[data-jump]").forEach((link) =>
    link.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById(link.dataset.jump!)?.scrollIntoView({ behavior: "smooth" });
    })
  );

  document.querySelectorAll<HTMLButtonElement>(".view-btn").forEach((btn) =>
    btn.addEventListener("click", () => { state.view = btn.dataset.view!; render(); })
  );
  document.querySelectorAll<HTMLButtonElement>(".gender-btn").forEach((btn) =>
    btn.addEventListener("click", () => { state.gender = btn.dataset.gender!; render(); })
  );
  render();
</script>
